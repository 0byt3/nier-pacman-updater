[Unit]
Description=Check upstream releases, build packages and publish the Nier pacman repository
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=nier-updater
Group=nier-updater
Environment=HOME=/var/lib/nier-pacman-updater
Environment=XDG_RUNTIME_DIR=/run/nier-pacman-updater
Environment=GNUPGHOME=/var/lib/nier-pacman-updater/gnupg
Environment=TMPDIR=/var/lib/nier-pacman-updater/tmp
EnvironmentFile=-/etc/nier-pacman-updater/environment
RuntimeDirectory=nier-pacman-updater
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/share/nier/bin/nier-pacman-updater
TimeoutStartSec=2h
TimeoutStopSec=45
KillMode=control-group
UMask=0022
ProtectSystem=full
ProtectHome=yes
MemoryMax=6G
CPUQuota=300%
TasksMax=4096

